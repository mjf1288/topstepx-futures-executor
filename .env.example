# TopstepX Futures Executor — environment template
#
# 1. Copy this file to `.env` (which is gitignored)
# 2. Replace placeholder values with your real credentials
# 3. Never commit .env to git

# ── ProjectX / TopstepX API credentials ──────────────────────────────
# Get these from https://topstepx.com after subscribing to
# Personal API Access ($29/mo, $14.50/mo with promo code 'topstep').

PROJECT_X_USERNAME=your_topstep_username
PROJECT_X_API_KEY=your_api_key_here

# Which trading account this engine should trade on.
# Look up available account names via TopstepX UI or by running:
#   python -c "from dotenv import load_dotenv; load_dotenv(); \
#     from topstep_api import from_env; api = from_env(); \
#     print(api.get_account_info().name)"
# Common formats:
#   EXPRESS-V2-CT-<account_id>       (Express funded)
#   50KTC-V2-<account_id>            (50K Combine)
#   150KTC-V2-<account_id>           (150K Combine)
PROJECT_X_ACCOUNT_NAME=EXPRESS-V2-CT-000000-00000000
